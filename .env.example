# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Ollama Model Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Role-specific models (optional - will use OLLAMA_MODEL if not specified)
# MODEL_PROGRAM_MANAGER=llama3.1:8b-instruct-q4_K_M
# MODEL_CHIEF_ENGINEER=llama3.1:8b-instruct-q4_K_M
# MODEL_REQUIREMENTS=llama3.1:8b-instruct-q4_K_M
# MODEL_ARCHITECTURE=llama3.1:8b-instruct-q4_K_M
# MODEL_LOW_COMPLEXITY=qwen2.5:7b-instruct-q4_K_M
# MODEL_MEDIUM_COMPLEXITY=llama3.1:8b-instruct-q4_K_M
# MODEL_HIGH_COMPLEXITY=llama3.1:70b-instruct-q4_K_M
ENABLE_ADAPTIVE_MODEL_ROUTING=true
ADAPTIVE_LATENCY_THRESHOLD_SECONDS=2.5
ADAPTIVE_ERROR_THRESHOLD=2

# PostgreSQL Persistence
POSTGRES_URL=postgresql://agentic:agentic@localhost:5432/agentic_sdlc
CHECKPOINT_TABLE=langgraph_checkpoints
VECTOR_TABLE=agent_embeddings

# Human-in-the-Loop Settings
ENABLE_HITL=true
HITL_TIMEOUT_SECONDS=300
AUTO_APPROVE_LOW_RISK=false

# Performance Settings
DEFAULT_TIMEOUT_SECONDS=120
MAX_ITERATIONS=25
TEMPERATURE=0.7

# Memory & Context
ENABLE_VECTOR_MEMORY=true
MAX_CONTEXT_MESSAGES=20
SUMMARIZATION_THRESHOLD=10

# Observability (Optional)
ENABLE_TRACING=false
# LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=agentic-sdlc-ai

# Structured logging backend integration (stub)
ENABLE_OBSERVABILITY_BACKEND=false
# OBSERVABILITY_BACKEND_URL=http://localhost:9200/agentic-events/_doc
# OBSERVABILITY_BACKEND_TOKEN=your_token_here
